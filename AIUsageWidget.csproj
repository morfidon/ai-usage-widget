<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AIUsageWidget</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppHostRelativeDotNet>../dotnet</AppHostRelativeDotNet>
    <AppHostDotNetSearch>AppRelative;Global</AppHostDotNetSearch>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**;data/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets/*.svg" />
  </ItemGroup>
</Project>
